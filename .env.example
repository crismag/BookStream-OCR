# BookStream OCR configuration. Copy to .env (next to the app/ folder, NOT in public_html).

# --- First-run setup: needed once to create the owner account. Remove after setup. ---
SETUP_TOKEN=change-me-to-a-long-random-string

# --- Database: mysql in production (Hostinger hPanel → Databases), sqlite for local dev ---
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_bookstream
DB_USER=u000000000_bookstream
DB_PASS=
# DB_DRIVER=sqlite
# DB_PATH=/absolute/path/to/storage/bookstream.sqlite

# --- Storage (default: ../storage next to app/) ---
# STORAGE_DIR=/home/u000000000/domains/example.com/bookstream/storage

# --- Security ---
FORCE_HTTPS=true
SESSION_IDLE_SECONDS=43200
# Optional laptop OCR worker token (24+ random chars). Leave empty to disable.
WORKER_TOKEN=

# --- Limits ---
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=60000000
UPLOADS_PER_MINUTE=120
CLIENT_MAX_PENDING=25

# --- OCR ---
# Languages without their own model are read with the Latin "eng" model, dictionaries off.
OCR_MODELS=eng
OCR_LANG_MAP=mrw=eng
OCR_REVIEW_CONFIDENCE=80
